# ==========================================
# 1. Existing Project Rules
# ==========================================
backend/*.db
backend/uploads/*
!backend/uploads/.gitkeep
.env
.env.*
!.env.example

# ==========================================
# 2. Frontend / Node / Vite (Stops "Folders within Folders")
# ==========================================
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 3. Python / Backend Cache & Environments
# ==========================================
__pycache__/
backend/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
backend/.venv/
backend/venv/
backend/env/

# ==========================================
# 4. OS & IDE Metadata
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?